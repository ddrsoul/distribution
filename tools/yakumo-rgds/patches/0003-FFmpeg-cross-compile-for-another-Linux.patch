From 2a10683a236f1eedab589a4b443cb69a2cb6a832 Mon Sep 17 00:00:00 2001
From: rgds <rgds@localhost>
Date: Mon, 5 Oct 2026 06:11:22 +0000
Subject: [PATCH 3/3] FFmpeg: cross-compile for another Linux

---
 profiles/mhp3rd/cmake/FFmpeg.cmake | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/profiles/mhp3rd/cmake/FFmpeg.cmake b/profiles/mhp3rd/cmake/FFmpeg.cmake
index ec1f065..057852d 100644
--- a/profiles/mhp3rd/cmake/FFmpeg.cmake
+++ b/profiles/mhp3rd/cmake/FFmpeg.cmake
@@ -228,6 +228,25 @@ else()
             "--ranlib=${_mhp3rd_ndk_bin}/llvm-ranlib" "--strip=${_mhp3rd_ndk_bin}/llvm-strip"
             # Pages may be 16 KiB on current devices; the NDK's own flag for it.
             "--extra-ldflags=-Wl,-z,max-page-size=16384")
+    elseif(CMAKE_CROSSCOMPILING AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
+        # Cross-compiled for another Linux (an aarch64 handheld, say) with
+        # the compilers of the rest of the build.
+        string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _mhp3rd_ffmpeg_arch)
+        list(APPEND _mhp3rd_ffmpeg_flags
+            --enable-cross-compile --target-os=linux "--arch=${_mhp3rd_ffmpeg_arch}"
+            "--cc=${CMAKE_C_COMPILER}" "--cxx=${CMAKE_CXX_COMPILER}")
+        if(CMAKE_AR)
+            list(APPEND _mhp3rd_ffmpeg_flags "--ar=${CMAKE_AR}")
+        endif()
+        if(CMAKE_NM)
+            list(APPEND _mhp3rd_ffmpeg_flags "--nm=${CMAKE_NM}")
+        endif()
+        if(CMAKE_RANLIB)
+            list(APPEND _mhp3rd_ffmpeg_flags "--ranlib=${CMAKE_RANLIB}")
+        endif()
+        if(CMAKE_STRIP)
+            list(APPEND _mhp3rd_ffmpeg_flags "--strip=${CMAKE_STRIP}")
+        endif()
     elseif(DEFINED ENV{CC})
         list(APPEND _mhp3rd_ffmpeg_flags "--cc=$ENV{CC}")
     endif()
-- 

diff --git a/profiles/mhp3rd/tests/game_aspect_tests.cpp b/profiles/mhp3rd/tests/game_aspect_tests.cpp
index 0bcee06..280f1ee 100644
--- a/profiles/mhp3rd/tests/game_aspect_tests.cpp
+++ b/profiles/mhp3rd/tests/game_aspect_tests.cpp
@@ -108,6 +108,50 @@ void test_other_code_is_left_alone() {
     check(f.memory().load32(kCamera + 0x8u) == kGameAspectBits, "nor to its camera");
 }
 
+void test_vert_plus_and_back() {
+    Fixture f;
+    check(prepare_game_aspect(f.runtime), "the matching game code is accepted");
+    const float narrow = 4.0f / 3.0f;
+    const float wider = keep_width_fov(kFieldOfView, narrow);
+    // The horizontal extent stays the PSP's: tan(fov'/2) * 4/3 = tan(fov/2) * 480/272.
+    check(std::abs(std::tan(0.5f * wider) * narrow - std::tan(0.5f * kFieldOfView) * kGameAspect) < 1e-5f,
+        "Vert+ keeps the PSP's horizontal view at 4:3");
+    check(keep_width_fov(kFieldOfView, 21.0f / 9.0f) == kFieldOfView, "Vert+ leaves wider shapes alone");
+    check(keep_width_fov(kFieldOfView, 0.3f) <= 1.6f, "Vert+ opens the view at most so far");
+
+    game_aspect_frame(f.runtime, narrow, true);
+    check(read_float(f.memory(), kCamera + 0x8u) == narrow, "4:3 reaches the camera");
+    check(read_float(f.memory(), kCamera + 0xCu) == wider, "Vert+ widens the camera's field of view");
+    check(read_float(f.memory(), kCamera + 0x10u) != wider, "the camera builds its projection again");
+    check(read_float(f.memory(), kCullDepthConstant) >= -1.5f, "the culling planes stay within the game's");
+
+    // The camera's update rebuilds; the port's field of view is kept, not widened twice.
+    write_float(f.runtime.memory(), kCamera + 0x10u, wider);
+    game_aspect_frame(f.runtime, narrow, true);
+    check(read_float(f.memory(), kCamera + 0xCu) == wider, "Vert+ does not widen its own field of view");
+    check(read_float(f.memory(), kCamera + 0x10u) == wider, "an unchanged view forces nothing");
+
+    // The game sets a field of view of its own: that one is widened.
+    write_float(f.runtime.memory(), kCamera + 0xCu, 0.6f);
+    game_aspect_frame(f.runtime, narrow, true);
+    check(read_float(f.memory(), kCamera + 0xCu) == keep_width_fov(0.6f, narrow), "the game's new view is widened");
+
+    // Keep height again: the game's own field of view comes back bit for bit.
+    game_aspect_frame(f.runtime, narrow, false);
+    check(read_float(f.memory(), kCamera + 0xCu) == 0.6f, "Keep height restores the game's field of view");
+    write_float(f.runtime.memory(), kCamera + 0xCu, kFieldOfView);
+    game_aspect_frame(f.runtime, narrow, true);
+    game_aspect_frame(f.runtime, kGameAspect, true);
+    check(f.memory().load32(kAspectConstant) == kGameAspectBits, "off restores the constant bit for bit");
+    check(f.memory().load32(kCullDepthConstant) == kGameCullDepthBits, "off restores the culling constant");
+    check(f.memory().load32(kCamera + 0x8u) == kGameAspectBits, "off restores the camera's aspect bit for bit");
+    check(read_float(f.memory(), kCamera + 0xCu) == kFieldOfView, "off restores the field of view bit for bit");
+
+    write_float(f.runtime.memory(), kCamera + 0x10u, 1.0f);
+    game_aspect_frame(f.runtime, kGameAspect, true);
+    check(read_float(f.memory(), kCamera + 0x10u) == 1.0f, "once restored, nothing more is written");
+}
+
 } // namespace
 
 int main() {
@@ -115,6 +159,7 @@ int main() {
     test_wide_and_back();
     test_camera_set_up_later();
     test_other_code_is_left_alone();
+    test_vert_plus_and_back();
     if (failures != 0) {
         std::cerr << failures << " failure(s)\n";
         return 1;

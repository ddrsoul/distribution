diff --git a/profiles/mhp3rd/host/platform/split_screen.hpp b/profiles/mhp3rd/host/platform/split_screen.hpp
new file mode 100644
index 0000000..dbe3c04
--- /dev/null
+++ b/profiles/mhp3rd/host/platform/split_screen.hpp
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <cstdio>
+#include <cstdlib>
+
+// Two screens one above the other, as on the Anbernic RG DS: the window
+// covers both, the game's picture goes on the upper one and the on-screen
+// controls on the lower one. MHP3RD_SPLIT_SCREEN=<width>x<height> gives one
+// screen's size in pixels (640x480 on the RG DS); the window is that wide and
+// twice as high. Unset, or anything else, and the window is one screen.
+namespace mhp3rd::platform {
+
+struct SplitScreen {
+    bool on{};
+    int width{};  // one screen's size
+    int height{};
+};
+
+[[nodiscard]] inline const SplitScreen &split_screen() {
+    static const SplitScreen value = [] {
+        SplitScreen split;
+        const char *text = std::getenv("MHP3RD_SPLIT_SCREEN");
+        int width = 0;
+        int height = 0;
+        if (text != nullptr && std::sscanf(text, "%dx%d", &width, &height) == 2 && width >= 64 && height >= 64 &&
+            width <= 8192 && height <= 8192)
+            split = {true, width, height};
+        return split;
+    }();
+    return value;
+}
+
+} // namespace mhp3rd::platform

+// The background list is clipped to the interface's area, which on two
+// screens is the upper one only (platform/split_screen.hpp); the controls
+// may be anywhere in the window.
+struct WholeWindow {
+    ImDrawList *list;
+    explicit WholeWindow(ImDrawList *l) : list(l) { list->PushClipRect({0.0f, 0.0f}, {65536.0f, 65536.0f}, false); }
+    ~WholeWindow() { list->PopClipRect(); }
+    WholeWindow(const WholeWindow &) = delete;
+    WholeWindow &operator=(const WholeWindow &) = delete;
+};
